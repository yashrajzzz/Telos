{
  "manifest_version": 3,
  "name": "Telos",
  "version": "2.0.2",
  "description": "A developer-styled homepage: live clock, sticky notes, to-do list, and quick shortcuts.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
