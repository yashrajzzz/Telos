{
  "manifest_version": 3,
  "name": "Telos",
  "version": "1.1.0",
  "description": "A developer-styled homepage: live clock, sticky notes, to-do list, shortcuts, and top browser tabs.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "topSites",
    "history",
    "sessions",
    "tabs",
    "favicon"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
